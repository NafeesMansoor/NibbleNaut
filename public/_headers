# Cache headers for Netlify / Cloudflare Pages (other hosts: see "Releasing" in README.md).
# sw.js and the HTML must always be revalidated so players pick up new releases.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Content-hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
